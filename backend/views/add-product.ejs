<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - Fresh Fashion Admin</title>
    <!-- Tailwind CSS & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .base-bg {
            background-color: #0F172A;
            overflow-x: hidden;
        }
        
        /* Glassmorphic Layout Styles */
        .glass-sidebar {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .glass-panel {
            background: rgba(30, 41, 59, 0.25);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .glass-input {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #f3f4f6;
            transition: all 0.3s ease;
        }
        .glass-input:focus {
            background: rgba(15, 23, 42, 0.8);
            border-color: #06b6d4;
            box-shadow: 0 0 15px rgba(6, 182, 212, 0.2);
        }

        /* Nav link effects */
        .nav-item {
            transition: all 0.3s ease;
        }
        .nav-item:hover {
            background: linear-gradient(90deg, rgba(6, 182, 212, 0.1) 0%, rgba(147, 51, 234, 0.02) 100%);
            color: #ffffff;
        }
        .nav-item.active {
            background: linear-gradient(90deg, rgba(6, 182, 212, 0.15) 0%, rgba(147, 51, 234, 0.05) 100%);
            border-left: 4px solid #06b6d4;
            color: #ffffff;
        }

        /* Moving ambient background glow */
        @keyframes wave {
            0%, 100% { transform: translate(0px, 0px) scale(1); }
            50% { transform: translate(-40px, 60px) scale(1.15); }
        }
        .glow-purple {
            animation: wave 16s ease-in-out infinite;
        }
    </style>
</head>
<body class="base-bg min-h-screen font-sans text-gray-200 flex relative">

    <!-- DYNAMIC AMBIENT GLOW -->
    <div class="absolute top-[-10%] right-[20%] w-[600px] h-[600px] bg-purple-600/5 rounded-full blur-[130px] pointer-events-none glow-purple"></div>

    <!-- ================= SIDEBAR NAVIGATION ================= -->
    <aside class="w-72 min-h-screen glass-sidebar flex flex-col justify-between fixed left-0 top-0 z-30 hidden md:flex">
        <div>
            <!-- Header Brand Branding -->
            <div class="p-6 border-b border-white/5 flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-slate-900 border border-white/10 p-0.5 overflow-hidden shadow-md">
                    <img src="/logo.png" alt="Logo" class="w-full h-full object-cover rounded-full">
                </div>
                <div>
                    <h1 class="font-black text-sm text-white uppercase tracking-wider">Fresh Fashion</h1>
                    <span class="text-[10px] text-cyan-400 font-bold tracking-widest bg-cyan-500/10 px-1.5 py-0.5 rounded">ADMIN CONTROL</span>
                </div>
            </div>

            <!-- User Welcome Info -->
            <div class="p-5 mx-4 my-4 rounded-xl bg-slate-950/40 border border-white/5 flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-cyan-500 to-purple-500 flex items-center justify-center text-white font-bold text-sm shadow-md">
                    A
                </div>
                <div>
                    <p class="text-xs text-gray-400">Logged in as</p>
                    <h4 class="text-sm font-bold text-white">👋 Welcome Admin</h4>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="mt-6 space-y-1 px-3">
                <a href="/admin/dashboard" class="nav-item flex items-center gap-3 px-4 py-3.5 text-sm font-semibold rounded-xl text-gray-400">
                    <i class="fa-solid fa-chart-pie text-base"></i>
                    Dashboard Overview
                </a>
                <a href="/admin/total-products" class="nav-item flex items-center gap-3 px-4 py-3.5 text-sm font-semibold rounded-xl text-gray-400">
                    <i class="fa-solid fa-box text-base"></i>
                    📦 Total Products
                </a>
                <a href="/admin/add-product" class="nav-item active flex items-center gap-3 px-4 py-3.5 text-sm font-semibold rounded-xl text-gray-300">
                    <i class="fa-solid fa-square-plus text-base text-cyan-400"></i>
                    ➕ Add Product
                </a>
                <a href="/admin/manage-products" class="nav-item flex items-center gap-3 px-4 py-3.5 text-sm font-semibold rounded-xl text-gray-400">
                    <i class="fa-solid fa-list-check text-base"></i>
                    📋 Manage Products
                </a>
            </nav>
        </div>

        <!-- Logout Trigger -->
        <div class="p-4 border-t border-white/5">
            <a href="/logout" class="w-full py-3 px-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 font-bold text-sm hover:bg-red-500 hover:text-white transition-all duration-300 flex items-center justify-center gap-2">
                <i class="fa-solid fa-door-open"></i> 🚪 Logout System
            </a>
        </div>
    </aside>

    <!-- ================= MAIN CONTENT AREA ================= -->
    <main class="flex-1 md:ml-72 min-h-screen p-6 md:p-10 z-10 relative">
        
        <!-- HEADER -->
        <header class="mb-8 pb-5 border-b border-white/5">
            <h2 class="text-2xl font-black text-white tracking-tight">➕ Add Premium Product</h2>
            <p class="text-xs text-gray-400 mt-0.5">Upload new style articles directly into your online store database.</p>
        </header>

        <!-- ================= PRODUCT ENTRY FORM ================= -->
        <form action="/admin/add-product" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- LEFT COLUMN: MULTI-IMAGE UPLOAD CONTROLLER (SECURE MAX 8) -->
            <div class="lg:col-span-1 space-y-5">
                <div class="glass-panel p-6 rounded-2xl">
                    <div class="flex justify-between items-center mb-3">
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider">Product Images</label>
                        <span id="fileCounter" class="text-[10px] px-2 py-0.5 rounded bg-slate-900 font-bold text-cyan-400 border border-white/5">0 / 8 Selected</span>
                    </div>
                    
                    <!-- Drag & Drop Interactive Container -->
                    <div class="relative group border-2 border-dashed border-white/10 hover:border-cyan-500/40 rounded-xl p-6 text-center bg-slate-950/40 transition duration-300 flex flex-col items-center justify-center min-h-[260px]">
                        <!-- Input allows multiple files now -->
                        <input type="file" name="productImages" id="imageSelector" accept="image/*" multiple required 
                            class="absolute inset-0 opacity-0 cursor-pointer z-10">
                        
                        <!-- File Upload Icon Graphic -->
                        <div id="uploadIconContainer" class="w-14 h-14 bg-slate-900 rounded-full flex items-center justify-center text-gray-400 group-hover:text-cyan-400 border border-white/5 group-hover:border-cyan-500/20 shadow-lg transition mb-4">
                            <i class="fa-solid fa-images text-xl"></i>
                        </div>
                        
                        <!-- Visual Instructions -->
                        <div id="uploadTexts">
                            <p class="text-xs font-bold text-white tracking-wide">Click or Drag Images Here</p>
                            <p class="text-[10px] text-gray-500 mt-1">Maximum 8 photos allowed</p>
                        </div>

                        <!-- Real-time Multi-Image Preview Gallery Grid -->
                        <div id="previewGallery" class="hidden grid grid-cols-3 gap-2 absolute inset-2 p-1 bg-slate-950/90 rounded-lg overflow-y-auto pointer-events-none z-0">
                            <!-- JS will dump images here -->
                        </div>
                    </div>
                    
                    <!-- Error Message UI placeholder -->
                    <p id="securityAlert" class="hidden text-rose-400 text-[11px] font-bold mt-2 text-center">
                        <i class="fa-solid fa-triangle-exclamation mr-1"></i> Security Block: You can only upload up to 8 images!
                    </p>
                </div>
            </div>

            <!-- RIGHT COLUMN: ALPHANUMERIC METADATA WITH DISCOUNT SYSTEM -->
            <div class="lg:col-span-2 space-y-5">
                <div class="glass-panel p-6 md:p-8 rounded-2xl space-y-5">
                    
                    <!-- Form Row 1: Product Name -->
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Product Name</label>
                        <input type="text" name="name" placeholder="e.g., Casual Slim-fit Denim Jacket" required
                            class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm">
                    </div>

                    <!-- Form Row 2: Price, Discount Offer & Category Grid split -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                        <!-- Original Price Box -->
                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Price (₹ INR)</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm text-gray-400 font-semibold">₹</span>
                                <input type="number" name="price" placeholder="1999" min="0" required
                                    class="w-full pl-8 pr-4 py-3 rounded-xl outline-none glass-input text-sm">
                            </div>
                        </div>

                        <!-- NEW: Discount Offer Box -->
                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Discount Offer</label>
                            <div class="relative">
                                <input type="number" name="discount" placeholder="10" min="0" max="100"
                                    class="w-full pl-4 pr-8 py-3 rounded-xl outline-none glass-input text-sm">
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm text-gray-400 font-bold">% Off</span>
                            </div>
                        </div>

                        <!-- Category Selector Box -->
                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Category</label>
                            <select name="category" required
                                class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm cursor-pointer bg-slate-900">
                                <option value="" disabled selected class="text-gray-500">Select Category</option>
                                <option value="Men" class="text-white">Men's Wear</option>
                                <option value="Kids" class="text-white">Kids Wear</option>
                            </select>
                        </div>
                    </div>

                    <!-- Form Row 3: Product Description Textarea -->
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Description</label>
                        <textarea name="description" rows="4" placeholder="Describe the material quality, fit type, style guide, and wash care details..." required
                            class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm resize-none"></textarea>
                    </div>

                    <!-- ================= HERO SLIDER SETTINGS (ADDED HERE) ================= -->
                    <div class="pt-3 border-t border-white/5 space-y-4">
                        <div class="flex items-center justify-between">
                            <h3 class="text-xs font-bold text-cyan-400 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fa-solid fa-sliders"></i> Hero Slider Settings
                            </h3>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 items-center">
                            <!-- Checkbox: Show in Hero Slider -->
                            <div class="form-group bg-slate-950/40 p-3.5 rounded-xl border border-white/5">
                                <label class="flex items-center gap-3 cursor-pointer select-none">
                                    <input type="checkbox" name="highlighted" class="w-4 h-4 rounded border-gray-600 bg-slate-900 text-cyan-500 focus:ring-cyan-500 focus:ring-offset-slate-900 cursor-pointer">
                                    <span class="text-xs font-bold text-white">Show this product in Hero Slider</span>
                                </label>
                            </div>

                            <!-- Input: Hero Slider Order -->
                            <div class="form-group">
                                <label for="sliderOrder" class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">
                                    Hero Slider Order
                                </label>
                                <input type="number" id="sliderOrder" name="sliderOrder" min="0" value="0" placeholder="Example: 1"
                                    class="w-full px-4 py-2.5 rounded-xl outline-none glass-input text-sm">
                                <small class="block text-[10px] text-gray-500 mt-1">
                                    Lower number will appear first. Example: 1, 2, 3...
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- SUBMIT OPERATION BUTTON -->
                    <div class="pt-3">
                        <button type="submit" id="submitBtn"
                            class="w-full py-3.5 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-bold rounded-xl shadow-[0_4px_25px_rgba(6,182,212,0.2)] hover:shadow-[0_4px_30px_rgba(6,182,212,0.3)] transition-all duration-300 text-xs tracking-wider uppercase">
                            <i class="fa-solid fa-arrow-up-from-bracket mr-1.5"></i> Upload Product
                        </button>
                    </div>

                </div>
            </div>

        </form>
    </main>

    <!-- INTERACTIVE SECURITY & MULTI-IMAGE PREVIEW SCRIPT -->
    <script>
        const imageSelector = document.getElementById('imageSelector');
        const previewGallery = document.getElementById('previewGallery');
        const uploadIconContainer = document.getElementById('uploadIconContainer');
        const uploadTexts = document.getElementById('uploadTexts');
        const fileCounter = document.getElementById('fileCounter');
        const securityAlert = document.getElementById('securityAlert');
        const submitBtn = document.getElementById('submitBtn');

        imageSelector.addEventListener('change', function() {
            const files = this.files;
            
            // STRICT SECURITY GUARD: Max 8 pics check
            if (files.length > 8) {
                securityAlert.classList.remove('hidden');
                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.5';
                submitBtn.style.cursor = 'not-allowed';
                fileCounter.classList.replace('text-cyan-400', 'text-rose-400');
                fileCounter.innerText = `${files.length} / 8 Selected`;
                
                // Clear inputs to block malicious post requests
                this.value = '';
                previewGallery.classList.add('hidden');
                uploadIconContainer.classList.remove('hidden');
                uploadTexts.classList.remove('hidden');
                return;
            }

            // If files are within limit, unblock everything
            securityAlert.classList.add('hidden');
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
            fileCounter.classList.replace('text-rose-400', 'text-cyan-400');
            fileCounter.innerText = `${files.length} / 8 Selected`;

            // Render Multi-Image Grid Preview
            if (files.length > 0) {
                previewGallery.innerHTML = ''; // clear old ones
                previewGallery.classList.remove('hidden');
                uploadIconContainer.classList.add('hidden');
                uploadTexts.classList.add('hidden');

                Array.from(files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const imgWrapper = document.createElement('div');
                        imgWrapper.className = 'w-full aspect-[3/4] rounded bg-slate-900 border border-white/10 overflow-hidden';
                        imgWrapper.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
                        previewGallery.appendChild(imgWrapper);
                    }
                    reader.readAsDataURL(file);
                });
            } else {
                previewGallery.classList.add('hidden');
                uploadIconContainer.classList.remove('hidden');
                uploadTexts.classList.remove('hidden');
            }
        });
    </script>
</body>
</html>