<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Product - Fresh Fashion</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >
</head>

<body class="bg-slate-950 text-white min-h-screen">

    <div class="max-w-4xl mx-auto py-12 px-6">

        <div class="flex justify-between items-center mb-8">

            <div>
                <p class="text-cyan-400 text-xs font-bold uppercase">
                    Fresh Fashion Admin
                </p>

                <h1 class="text-3xl font-black mt-1">
                    Edit Product
                </h1>
            </div>

            <a
                href="/admin/manage-products"
                class="px-4 py-2 bg-slate-800 rounded-lg text-sm"
            >
                ← Back
            </a>

        </div>


        <form
            action="/admin/edit-product/<%= product._id %>"
            method="POST"
            enctype="multipart/form-data"
            class="bg-slate-900 border border-white/10 rounded-2xl p-7 space-y-6"
        >

            <div>

                <label class="text-xs text-gray-400">
                    Product Name
                </label>

                <input
                    type="text"
                    name="name"
                    value="<%= product.name %>"
                    required
                    class="w-full mt-2 px-4 py-3 rounded-xl bg-slate-950 border border-white/10 outline-none focus:border-cyan-500"
                >

            </div>


            <div class="grid md:grid-cols-3 gap-5">

                <div>

                    <label class="text-xs text-gray-400">
                        Price
                    </label>

                    <input
                        type="number"
                        name="price"
                        value="<%= product.price %>"
                        required
                        min="0"
                        class="w-full mt-2 px-4 py-3 rounded-xl bg-slate-950 border border-white/10 outline-none"
                    >

                </div>


                <div>

                    <label class="text-xs text-gray-400">
                        Discount %
                    </label>

                    <input
                        type="number"
                        name="discount"
                        value="<%= product.discount %>"
                        min="0"
                        max="100"
                        class="w-full mt-2 px-4 py-3 rounded-xl bg-slate-950 border border-white/10 outline-none"
                    >

                </div>


                <div>

                    <label class="text-xs text-gray-400">
                        Category
                    </label>

                    <select
                        name="category"
                        required
                        class="w-full mt-2 px-4 py-3 rounded-xl bg-slate-950 border border-white/10"
                    >

                        <option
                            value="Men"
                            <%= product.category === "Men" ? "selected" : "" %>
                        >
                            Men's Wear
                        </option>

                        <option
                            value="Kids"
                            <%= product.category === "Kids" ? "selected" : "" %>
                        >
                            Kids Wear
                        </option>

                    </select>

                </div>

            </div>


            <div>

                <label class="text-xs text-gray-400">
                    Description
                </label>

                <textarea
                    name="description"
                    required
                    rows="5"
                    class="w-full mt-2 px-4 py-3 rounded-xl bg-slate-950 border border-white/10 outline-none"
                ><%= product.description %></textarea>

            </div>


            <% if (product.images && product.images.length > 0) { %>

                <div>

                    <p class="text-xs text-gray-400 mb-3">
                        Current Images
                    </p>

                    <div class="grid grid-cols-3 md:grid-cols-6 gap-3">

                        <% product.images.forEach(image => { %>

                            <img
                                src="/uploads/<%= image %>"
                                class="w-full aspect-[3/4] object-cover rounded-lg border border-white/10"
                            >

                        <% }) %>

                    </div>

                </div>

            <% } %>


            <div>

                <label class="text-xs text-gray-400">
                    Replace Images
                </label>

                <input
                    type="file"
                    name="productImages"
                    multiple
                    accept="image/jpeg,image/png,image/webp"
                    class="block mt-2 text-sm text-gray-400"
                >

                <p class="text-[11px] text-gray-500 mt-2">
                    Leave empty to keep existing images. Maximum 8 images.
                </p>

            </div>


            <!-- ================= HERO SLIDER SETTINGS (ADDED HERE) ================= -->
            <div class="pt-4 border-t border-white/10 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold text-cyan-400 uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-sliders"></i> Hero Slider Settings
                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-center">
                    <!-- Checkbox: Show in Hero Slider -->
                    <div class="form-group bg-slate-950/60 p-3.5 rounded-xl border border-white/10">
                        <label class="flex items-center gap-3 cursor-pointer select-none">
                            <input
                                type="checkbox"
                                name="highlighted"
                                <%= product.highlighted ? "checked" : "" %>
                                class="w-4 h-4 rounded border-gray-600 bg-slate-900 text-cyan-500 focus:ring-cyan-500 focus:ring-offset-slate-900 cursor-pointer"
                            >
                            <span class="text-xs font-bold text-white">
                                Show this product in Hero Slider
                            </span>
                        </label>
                    </div>

                    <!-- Input: Hero Slider Order -->
                    <div class="form-group">
                        <label for="sliderOrder" class="block text-xs text-gray-400 mb-1">
                            Hero Slider Order
                        </label>
                        <input
                            type="number"
                            id="sliderOrder"
                            name="sliderOrder"
                            min="1"
                            value="<%= product.sliderOrder || 0 %>"
                            placeholder="Example: 1"
                            class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-white/10 outline-none focus:border-cyan-500 text-sm"
                        >
                        <small class="block text-[10px] text-gray-500 mt-1">
                            Lower number will appear first. Example: 1, 2, 3...
                        </small>
                    </div>
                </div>
            </div>


            <button
                type="submit"
                class="w-full py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 font-bold hover:from-blue-500 hover:to-cyan-400 transition-all duration-300"
            >

                <i class="fa-solid fa-floppy-disk mr-2"></i>

                Save Changes

            </button>

        </form>

    </div>

</body>
</html>