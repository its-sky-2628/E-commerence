<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login & Register - Fresh Fashion Studio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .base-bg {
            background-color: #0F172A;
            overflow: hidden;
        }

        /* PREMIUM MOVING BACKGROUND AURAS */
        @keyframes drift {
            0% { transform: translate(0px, 0px) scale(1); }
            50% { transform: translate(40px, -60px) scale(1.2); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        @keyframes drift-reverse {
            0% { transform: translate(0px, 0px) scale(1.2); }
            50% { transform: translate(-50px, 50px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1.2); }
        }

        .glow-purple {
            animation: drift 15s ease-in-out infinite;
        }
        .glow-cyan {
            animation: drift-reverse 18s ease-in-out infinite;
        }

        /* Glassmorphism Panel & Inputs */
        .glass-panel {
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-left: 1px solid rgba(255, 255, 255, 0.04);
        }

        .glass-input {
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #f3f4f6;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-input:focus {
            background: rgba(15, 23, 42, 0.85);
            border-color: #a855f7;
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.25);
        }
        .glass-input.admin-focus:focus {
            border-color: #06b6d4;
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.25);
        }

        /* Smooth Floating for Huge Logo */
        @keyframes floatLogo {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
            100% { transform: translateY(0px); }
        }
        .floating-logo {
            animation: floatLogo 5s ease-in-out infinite;
        }

        .fade-in {
            animation: fadeInEffect 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        @keyframes fadeInEffect {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }
    </style>
</head>
<body class="base-bg min-h-screen flex flex-col md:flex-row antialiased font-sans text-gray-200 relative">

    <!-- DYNAMIC BACKGROUND ANIMATIONS (Puri Screen Ke Liye) -->
    <div class="absolute top-[-10%] left-[-10%] w-[600px] h-[600px] bg-purple-600/10 rounded-full blur-[130px] pointer-events-none glow-purple"></div>
    <div class="absolute bottom-[-10%] right-[40%] w-[600px] h-[600px] bg-cyan-500/10 rounded-full blur-[130px] pointer-events-none glow-cyan"></div>

    <!-- ================= LEFT SIDE: BIGGER CINEMATIC SHOWCASE ================= -->
    <div class="w-full md:w-1/2 flex flex-col justify-center items-center p-12 relative min-h-[50vh] md:min-h-screen bg-slate-950/30 z-10">
        <div class="text-center max-w-lg">
            
            <!-- LOGO: Bada Kiya Aur Outer Glow Badhaya -->
            <div class="floating-logo mx-auto w-48 h-48 rounded-full bg-slate-900/90 p-2 border border-white/10 shadow-[0_0_50px_rgba(255,255,255,0.08)] flex items-center justify-center overflow-hidden mb-8">
                <img src="/images/logo1.png" alt="Fresh Fashion Studio Logo" class="w-full h-full object-cover rounded-full">
            </div>
            
            <!-- BRAND HEADING: 40% Bigger & Ultra Bold -->
            <h1 class="text-4xl md:text-5xl font-black tracking-tight text-white mb-4 bg-gradient-to-r from-white via-slate-100 to-slate-400 bg-clip-text text-transparent">
                Fresh Fashion Studio
            </h1>
            
            <div class="h-1 w-24 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto my-4 rounded-full shadow-[0_2px_10px_rgba(147,51,234,0.3)]"></div>
            
            <!-- TAGLINE: Spacious & Elegant -->
            <p class="text-base md:text-lg text-gray-400 font-medium tracking-wide max-w-md mx-auto leading-relaxed">
                Elevating Men's & Kids Wear for the Modern Style Era.
            </p>
        </div>
    </div>

    <!-- ================= RIGHT SIDE: DYNAMIC FORM PANEL ================= -->
    <div class="w-full md:w-1/2 flex items-center justify-center p-8 md:p-16 glass-panel relative z-20">
        
        <div class="w-full max-w-md">
            <!-- Form Header -->
            <div class="mb-8">
                <h2 class="text-3xl font-extrabold tracking-tight text-white" id="mainHeading">Create Account</h2>
                <p class="text-sm text-gray-400 mt-1" id="subHeading">Enter your details to join our studio collection</p>
            </div>

            <!-- Glass Capsule Switcher Tabs -->
            <div class="flex p-1 bg-slate-950/70 rounded-2xl mb-8 border border-white/5">
                <button type="button" id="userTab" onclick="switchRole('user')"
                    class="w-1/2 py-3 text-xs font-bold rounded-xl transition-all duration-300 flex items-center justify-center gap-2 bg-white/10 text-purple-400 border border-white/5 shadow-md">
                    <i class="fa-solid fa-user text-xs"></i> Customer
                </button>
                <button type="button" id="adminTab" onclick="switchRole('admin')"
                    class="w-1/2 py-3 text-xs font-bold rounded-xl transition-all duration-300 flex items-center justify-center gap-2 text-gray-400 hover:text-white">
                    <i class="fa-solid fa-user-shield text-xs"></i> Admin Portal
                </button>
            </div>

            <!-- Main Interactive Form -->
            <form id="loginForm" action="/customer/register" method="POST" class="space-y-5">
                <input type="hidden" name="role" id="userRole" value="user">

                <!-- ================= CUSTOMER ONLY FIELDS ================= -->
                <div id="customerFields" class="space-y-5 fade-in">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Username</label>
                        <input type="text" name="username" id="usernameInput" placeholder="John Doe" required
                            class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm">
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Mobile Number</label>
                        <input type="tel" name="mobile" id="mobileInput" placeholder="9876543210" pattern="[0-9]{10}" required
                            class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm">
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Age</label>
                            <input type="number" name="age" id="ageInput" placeholder="22" min="1" max="120" required
                                class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Gender</label>
                            <select name="gender" id="genderInput" required
                                class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm cursor-pointer bg-slate-900">
                                <option value="" disabled selected class="text-gray-500">Select</option>
                                <option value="male" class="text-white">Male</option>
                                <option value="female" class="text-white">Female</option>
                                <option value="other" class="text-white">Other</option>
                            </select>
                        </div>
                    </div>
                </div>
                <!-- ================= /CUSTOMER ONLY FIELDS ================= -->

                <!-- ================= COMMON FIELDS ================= -->
                <div>
                    <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Email Address</label>
                    <input type="email" name="email" placeholder="name@example.com" required
                        class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm">
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider">Password</label>
                        <a href="#" id="forgotBtn" class="text-xs font-bold text-purple-400 hover:text-purple-300 hover:underline transition">Forgot?</a>
                    </div>
                    <input type="password" name="password" placeholder="••••••••" required
                        class="w-full px-4 py-3 rounded-xl outline-none glass-input text-sm">
                </div>

                <!-- GRADIENT ACTION BUTTON -->
                <button type="submit" id="submitBtn"
                    class="w-full py-3.5 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-bold rounded-xl shadow-[0_4px_25px_rgba(147,51,234,0.3)] transition-all duration-300 text-sm mt-6 uppercase tracking-wider">
                    Register & Sign In
                </button>
                
                <p id="footerText" class="text-center text-xs text-gray-400 mt-6">
                    Already have an account? <a href="/login" class="text-purple-400 font-bold hover:underline transition">Log In</a>
                </p>
            </form>
        </div>
    </div>

    <!-- JAVASCRIPT FOR DYNAMIC SWITCHING -->
    <script>
        const userTab = document.getElementById('userTab');
        const adminTab = document.getElementById('adminTab');
        const userRoleInput = document.getElementById('userRole');
        const submitBtn = document.getElementById('submitBtn');
        const footerText = document.getElementById('footerText');
        const forgotBtn = document.getElementById('forgotBtn');
        const customerFields = document.getElementById('customerFields');
        const mainHeading = document.getElementById('mainHeading');
        const subHeading = document.getElementById('subHeading');
        const loginForm = document.getElementById('loginForm');

        const customerInputs = [
            'usernameInput',
            'mobileInput',
            'ageInput',
            'genderInput'
        ];

        function setCustomerFieldsRequired(required) {
            customerInputs.forEach(id => {
                document.getElementById(id).required = required;
            });
        }

        function switchRole(role) {
            userRoleInput.value = role;

            if (role === 'user') {
                showCustomerRegister();
            } else {
                showAdminLogin();
            }
        }

        function showCustomerRegister() {
            userRoleInput.value = 'user';
            loginForm.action = '/customer/register';

            customerFields.classList.remove('hidden');
            setCustomerFieldsRequired(true);

            mainHeading.innerText = 'Create Account';
            subHeading.innerText =
                'Enter your details to join our studio collection';

            submitBtn.innerText = 'Register & Sign In';

            userTab.className =
                'w-1/2 py-3 text-xs font-bold rounded-xl transition-all duration-300 flex items-center justify-center gap-2 bg-white/10 text-purple-400 border border-white/5 shadow-md';

            adminTab.className =
                'w-1/2 py-3 text-xs font-bold rounded-xl transition-all duration-300 flex items-center justify-center gap-2 text-gray-400 hover:text-white';

            submitBtn.className =
                'w-full py-3.5 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-bold rounded-xl shadow-[0_4px_25px_rgba(147,51,234,0.3)] transition-all duration-300 text-sm mt-6 uppercase tracking-wider';

            forgotBtn.className =
                'text-xs font-bold text-purple-400 hover:text-purple-300 hover:underline transition';

            footerText.innerHTML =
                'Already have an account? <button type="button" onclick="showCustomerLogin()" class="text-purple-400 font-bold hover:underline transition">Log In</button>';
        }

        function showCustomerLogin() {
            userRoleInput.value = 'user';
            loginForm.action = '/customer/login';

            customerFields.classList.add('hidden');
            setCustomerFieldsRequired(false);

            mainHeading.innerText = 'Welcome Back';
            subHeading.innerText =
                'Enter your email and password to continue';

            submitBtn.innerText = 'Log In';

            footerText.innerHTML =
                'New customer? <button type="button" onclick="showCustomerRegister()" class="text-purple-400 font-bold hover:underline transition">Create Account</button>';
        }

        function showAdminLogin() {
            userRoleInput.value = 'admin';
            loginForm.action = '/login';

            customerFields.classList.add('hidden');
            setCustomerFieldsRequired(false);

            mainHeading.innerText = 'Admin Portal';
            subHeading.innerText =
                'Enter secure administrative credentials';

            submitBtn.innerText = 'Access Panel';

            adminTab.className =
                'w-1/2 py-3 text-xs font-bold rounded-xl transition-all duration-300 flex items-center justify-center gap-2 bg-white/10 text-cyan-400 border border-white/5 shadow-md';

            userTab.className =
                'w-1/2 py-3 text-xs font-bold rounded-xl transition-all duration-300 flex items-center justify-center gap-2 text-gray-400 hover:text-white';

            submitBtn.className =
                'w-full py-3.5 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-bold rounded-xl shadow-[0_4px_25px_rgba(6,182,212,0.3)] transition-all duration-300 text-sm mt-6 uppercase tracking-wider';

            forgotBtn.className =
                'text-xs font-bold text-cyan-400 hover:text-cyan-300 hover:underline transition';

            footerText.innerHTML =
                '<span class="text-gray-500"><i class="fa-solid fa-lock"></i> Authorized Access Only</span>';
        }

        switchRole('user');
    </script>
</body>
</html>