<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Products - Fresh Fashion</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

</head>


<body class="bg-slate-950 min-h-screen text-gray-200">

    <main class="max-w-7xl mx-auto p-6 md:p-10">


        <!-- HEADER -->

        <header
            class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-8"
        >

            <div>

                <p class="text-cyan-400 text-xs font-bold uppercase">
                    Fresh Fashion Admin
                </p>

                <h1 class="text-3xl font-black text-white">
                    Manage Products
                </h1>

                <p class="text-sm text-gray-500 mt-1">

                    <%= products.length %>
                    product<%= products.length === 1 ? "" : "s" %>
                    in catalogue

                </p>

            </div>


            <div class="flex gap-3">

                <a
                    href="/admin"
                    class="px-4 py-3 bg-slate-800 rounded-xl text-sm font-bold"
                >
                    Dashboard
                </a>

                <a
                    href="/admin/add-product"
                    class="px-4 py-3 bg-cyan-600 hover:bg-cyan-500 rounded-xl text-sm font-bold text-white"
                >
                    + Add Product
                </a>

            </div>

        </header>


        <% if (products.length > 0) { %>

            <div
                class="bg-slate-900/70 border border-white/10 rounded-2xl overflow-hidden"
            >

                <div class="overflow-x-auto">

                    <table class="w-full">

                        <thead>

                            <tr
                                class="text-left text-xs uppercase text-gray-500 border-b border-white/10"
                            >

                                <th class="p-5">
                                    Image
                                </th>

                                <th class="p-5">
                                    Product
                                </th>

                                <th class="p-5">
                                    Category
                                </th>

                                <th class="p-5">
                                    Price
                                </th>

                                <th class="p-5">
                                    Discount
                                </th>

                                <th class="p-5 text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% products.forEach(product => { %>

                                <tr
                                    class="border-b border-white/5 hover:bg-white/[0.02]"
                                >

                                    <!-- IMAGE -->

                                    <td class="p-5">

                                        <div
                                            class="w-16 h-20 rounded-lg bg-slate-800 overflow-hidden"
                                        >

                                            <% if (
                                                product.images &&
                                                product.images.length > 0
                                            ) { %>

                                                <img
                                                    src="/uploads/<%= product.images[0] %>"
                                                    alt="<%= product.name %>"
                                                    class="w-full h-full object-cover"
                                                >

                                            <% } else { %>

                                                <div
                                                    class="w-full h-full flex items-center justify-center text-gray-600"
                                                >
                                                    <i class="fa-solid fa-image"></i>
                                                </div>

                                            <% } %>

                                        </div>

                                    </td>


                                    <!-- PRODUCT -->

                                    <td class="p-5">

                                        <h3 class="font-bold text-white">
                                            <%= product.name %>
                                        </h3>

                                        <p
                                            class="text-xs text-gray-500 mt-1 max-w-xs truncate"
                                        >
                                            <%= product.description %>
                                        </p>

                                    </td>


                                    <!-- CATEGORY -->

                                    <td class="p-5">

                                        <span
                                            class="px-3 py-1 bg-purple-500/10 text-purple-400 rounded-lg text-xs"
                                        >
                                            <%= product.category %>
                                        </span>

                                    </td>


                                    <!-- PRICE -->

                                    <td class="p-5">

                                        <span class="font-bold text-cyan-400">

                                            ₹<%= product.price.toLocaleString("en-IN") %>

                                        </span>

                                    </td>


                                    <!-- DISCOUNT -->

                                    <td class="p-5">

                                        <% if (product.discount > 0) { %>

                                            <span class="text-green-400 font-bold">

                                                <%= product.discount %>% OFF

                                            </span>

                                        <% } else { %>

                                            <span class="text-gray-600">
                                                —
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="p-5">

                                        <div
                                            class="flex justify-center gap-2"
                                        >

                                            <a
                                                href="/admin/edit-product/<%= product._id %>"
                                                class="w-10 h-10 bg-cyan-500/10 text-cyan-400 rounded-lg flex items-center justify-center hover:bg-cyan-500 hover:text-white"
                                                title="Edit"
                                            >

                                                <i class="fa-solid fa-pen"></i>

                                            </a>


                                            <form
                                                action="/admin/delete-product/<%= product._id %>"
                                                method="POST"
                                                onsubmit="return confirm('Delete this product?')"
                                            >

                                                <button
                                                    type="submit"
                                                    class="w-10 h-10 bg-red-500/10 text-red-400 rounded-lg hover:bg-red-500 hover:text-white"
                                                    title="Delete"
                                                >

                                                    <i class="fa-solid fa-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>

        <% } else { %>


            <!-- EMPTY STATE -->

            <div
                class="text-center bg-slate-900 border border-white/10 rounded-2xl py-20"
            >

                <i
                    class="fa-solid fa-box-open text-5xl text-gray-700"
                ></i>

                <h2 class="text-xl font-bold mt-5">
                    No Products Yet
                </h2>

                <p class="text-gray-500 mt-2">
                    Start building your Fresh Fashion catalogue.
                </p>

                <a
                    href="/admin/add-product"
                    class="inline-block mt-6 bg-cyan-600 px-5 py-3 rounded-xl font-bold"
                >
                    Add First Product
                </a>

            </div>

        <% } %>

    </main>

</body>

</html>