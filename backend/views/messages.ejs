<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Messages | Fresh Fashion</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >
</head>


<body class="bg-slate-950 text-white min-h-screen">

  <main class="max-w-6xl mx-auto p-5 md:p-10">

    <header
      class="flex flex-col md:flex-row justify-between md:items-center gap-4 mb-10"
    >

      <div>

        <p
          class="text-cyan-400 text-xs font-bold uppercase tracking-[3px]"
        >
          Fresh Fashion Admin
        </p>

        <h1 class="text-3xl font-black mt-2">
          Customer Messages
        </h1>

        <p class="text-gray-500 text-sm mt-2">
          <%= messages.length %> total enquiries
        </p>

      </div>


      <div class="flex gap-3">

        <a
          href="/admin"
          class="px-4 py-3 bg-slate-800 rounded-xl text-sm font-bold"
        >
          <i class="fa-solid fa-arrow-left mr-2"></i>
          Dashboard
        </a>

        <a
          href="/admin/manage-products"
          class="px-4 py-3 bg-cyan-600 rounded-xl text-sm font-bold"
        >
          Products
        </a>

      </div>

    </header>


    <% if (messages.length === 0) { %>

      <div
        class="bg-slate-900 border border-white/10 rounded-2xl text-center py-24"
      >

        <i
          class="fa-regular fa-envelope-open text-gray-700 text-5xl"
        ></i>

        <h2 class="font-black text-xl mt-5">
          No Messages Yet
        </h2>

        <p class="text-gray-500 mt-2">
          Customer enquiries will appear here.
        </p>

      </div>

    <% } %>


    <div class="space-y-5">

      <% messages.forEach(item => { %>

        <article
          class="p-6 rounded-2xl border
          <%= item.status === 'new'
            ? 'bg-cyan-500/[0.04] border-cyan-500/30'
            : 'bg-slate-900 border-white/10'
          %>"
        >

          <div
            class="flex flex-col md:flex-row justify-between gap-5"
          >

            <div>

              <div class="flex items-center gap-3">

                <h2 class="font-black text-lg">
                  <%= item.name %>
                </h2>

                <% if (item.status === "new") { %>

                  <span
                    class="text-[10px] uppercase font-bold bg-cyan-500/10 text-cyan-400 px-2 py-1 rounded"
                  >
                    New
                  </span>

                <% } %>

              </div>


              <a
                href="mailto:<%= item.email %>"
                class="text-cyan-400 text-sm inline-block mt-1"
              >
                <%= item.email %>
              </a>


              <p class="text-gray-600 text-xs mt-2">
                <%= new Date(item.createdAt).toLocaleString("en-IN") %>
              </p>

            </div>


            <div class="flex gap-2">

              <% if (item.status === "new") { %>

                <form
                  method="POST"
                  action="/admin/messages/<%= item._id %>/read"
                >
                  <button
                    class="px-3 py-2 bg-green-500/10 text-green-400 rounded-lg text-xs font-bold"
                  >
                    Mark Read
                  </button>
                </form>

              <% } %>


              <form
                method="POST"
                action="/admin/messages/<%= item._id %>/delete"
                onsubmit="return confirm('Delete this message?')"
              >

                <button
                  class="w-9 h-9 bg-red-500/10 text-red-400 rounded-lg"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>

              </form>

            </div>

          </div>


          <div
            class="mt-5 pt-5 border-t border-white/5"
          >

            <p
              class="text-gray-300 leading-7 whitespace-pre-wrap"
            ><%= item.message %></p>

          </div>

        </article>

      <% }) %>

    </div>

  </main>

</body>
</html>