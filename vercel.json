{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api"
    },
    {
      "source": "/login",
      "destination": "/api"
    },
    {
      "source": "/logout",
      "destination": "/api"
    }
  ]
}